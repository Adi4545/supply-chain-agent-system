# Database
DB__URL=sqlite:///./supply_chain.db

# LLM provider: mock | openai
LLM__PROVIDER=mock
LLM__OPENAI_API_KEY=
LLM__OPENAI_MODEL=gpt-4o-mini

# Orchestrator limits
ORCH__MAX_ITERATIONS=10
ORCH__AGENT_TIMEOUT_SECONDS=60
ORCH__TOTAL_TIMEOUT_SECONDS=300

# Optimizer scoring weights (must sum to 1.0)
OPT__WEIGHT_COST=0.30
OPT__WEIGHT_DELIVERY=0.20
OPT__WEIGHT_RELIABILITY=0.20
OPT__WEIGHT_RISK=0.15
OPT__WEIGHT_INVENTORY=0.15

# Safety caps
SAFETY__MAX_ORDER_QUANTITY=50000
SAFETY__MAX_SPEND=1000000

# Reproducibility
RANDOM__SEED=42

# Logging
LOG__LEVEL=INFO
